# Copy to .env and set for your environment
NODE_ENV=production
PORT=8080
DB_PATH=/app/data/appraisal.db
APP_URL=https://appraisals.pageos.org

# --- Login mode ---
# both = standing code OR emailed one-time code (default)
# otp  = emailed one-time code ONLY (recommended once email works)
# code = standing code only
LOGIN_MODE=otp

# Emergency access (optional but recommended with LOGIN_MODE=otp):
# lets ONE existing account sign in with a fixed code if email ever fails.
# Set to a real HC email + a strong code; remove once email is proven.
BREAKGLASS_EMAIL=
BREAKGLASS_CODE=

# --- Email (Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain
SMTP_PASS=your-mailbox-password
SMTP_FROM=Page Performance <no-reply@yourdomain>
