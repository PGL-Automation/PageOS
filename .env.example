# Copy to .env for local development. NEVER commit .env.
# Secrets are injected per-environment in staging/prod (see docs §15).

# --- Postgres ---
POSTGRES_USER=pageos
POSTGRES_PASSWORD=pageos
POSTGRES_DB=pageos

# --- API ---
PAGEOS_ENV=local
PAGEOS_HTTP_ADDR=:8080
PAGEOS_LOG_LEVEL=debug
# Host-side URL (for `make migrate-up` / `make run`):
PAGEOS_DATABASE_URL=postgres://pageos:pageos@localhost:5432/pageos?sslmode=disable

# --- MinIO (S3-compatible object store) ---
MINIO_ROOT_USER=pageos
MINIO_ROOT_PASSWORD=pageos-dev-secret

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8080
