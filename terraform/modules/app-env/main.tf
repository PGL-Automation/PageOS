terraform {
  required_providers {
    null = {
      source  = "hashicorp/null"
      version = "~> 3.0"
    }
  }
}

# ── Generate the .env file content ────────────────────────────────────────────

locals {
  env_content = <<-ENV
    # Generated by Terraform — do not edit by hand.
    # Re-run `terraform apply` in the relevant environment directory to update.

    # ── Database ──────────────────────────────────────────────────────────────
    POSTGRES_USER=${var.postgres_user}
    POSTGRES_PASSWORD=${var.postgres_password}
    POSTGRES_DB=${var.postgres_db}

    # ── MinIO object storage ──────────────────────────────────────────────────
    MINIO_ROOT_USER=${var.minio_root_user}
    MINIO_ROOT_PASSWORD=${var.minio_root_password}
    S3_BUCKET=${var.s3_bucket}

    # ── Web / API URLs ────────────────────────────────────────────────────────
    NEXT_PUBLIC_API_URL=${var.next_public_api_url}
    NEXT_PUBLIC_APP_ENV=${var.next_public_app_env}
    PAGEOS_ALLOWED_ORIGINS=${var.pageos_allowed_origins}

    # ── SMTP ──────────────────────────────────────────────────────────────────
    SMTP_HOST=${var.smtp_host}
    SMTP_PORT=${var.smtp_port}
    SMTP_USER=${var.smtp_user}
    SMTP_PASS=${var.smtp_pass}
    SMTP_FROM=${var.smtp_from}

    # ── Microsoft Graph (SSO + mailbox reading) ───────────────────────────────
    PAGEOS_MSGRAPH_CLIENT_ID=${var.msgraph_client_id}
    PAGEOS_MSGRAPH_CLIENT_SECRET=${var.msgraph_client_secret}
    PAGEOS_MSGRAPH_TENANT_ID=${var.msgraph_tenant_id}
    PAGEOS_MSGRAPH_REDIRECT_URL=${var.msgraph_redirect_url}
    PAGEOS_MSGRAPH_SSO_REDIRECT_URL=${var.msgraph_sso_redirect_url}
    PAGEOS_MSGRAPH_TOKEN_KEY=${var.msgraph_token_key}

    # ── Approval reply mailbox ────────────────────────────────────────────────
    PAGEOS_APPROVALS_EMAIL_USER=${var.approvals_email_user}
    PAGEOS_APPROVALS_EMAIL_PASS=${var.approvals_email_pass}
    PAGEOS_APPROVALS_IMAP_HOST=${var.approvals_imap_host}

    # ── Bank statement mailbox ────────────────────────────────────────────────
    PAGEOS_BANKSTMT_EMAIL_USER=${var.bankstmt_email_user}
    PAGEOS_BANKSTMT_EMAIL_PASS=${var.bankstmt_email_pass}
    PAGEOS_BANKSTMT_IMAP_HOST=${var.bankstmt_imap_host}
  ENV
}

# ── Write the .env file to the VPS via SSH ───────────────────────────────────
# The file provisioner copies the generated content directly over SSH.
# A trigger on the content hash ensures Terraform re-applies whenever any
# value changes, even if the resource definition itself did not change.

resource "null_resource" "env_file" {
  triggers = {
    env_hash = sha256(local.env_content)
  }

  connection {
    type        = "ssh"
    host        = var.vps_host
    user        = "root"
    private_key = var.vps_ssh_private_key
    timeout     = "30s"
  }

  provisioner "file" {
    content     = local.env_content
    destination = var.env_file_path
  }

  # Ensure the parent directory exists before writing.
  provisioner "remote-exec" {
    inline = [
      "mkdir -p $(dirname ${var.env_file_path})",
      "chmod 600 ${var.env_file_path}",
      "echo 'env file updated: ${var.env_file_path}'",
    ]
  }
}
